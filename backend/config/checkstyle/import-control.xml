<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
          "https://checkstyle.org/dtds/import_control_1_4.dtd">
<!--
  LƯU Ý: tên feature KHÔNG được trùng tên tầng (controller/service/dao/dto/model/filter/util);
  vì vậy domain "dịch vụ khách sạn" đặt là "hotelservice", không đặt là "service".

  Luật phụ thuộc giữa các tầng (QT 3). Mỗi khối dùng regex nên áp dụng được cho CẢ HAI cách tổ chức package:
    - chia theo tầng:    com.mycompany.hotelmanagersystem.controller.customer
    - chia theo feature: com.mycompany.hotelmanagersystem.booking.controller
  Khớp theo thứ tự: luật nào khớp trước thì áp dụng. Không khớp luật nào thì cho phép.
-->
<import-control pkg="com.mycompany.hotelmanagersystem" strategyOnMismatch="allowed">

  <!-- CONTROLLER: chỉ được gọi SERVICE. Cấm dao, java.sql, DBContext. -->
  <subpackage name="(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?controller" regex="true">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?dao(\..*)?" regex="true"/>
    <disallow class="com\.mycompany\.hotelmanagersystem\..*DBContext" regex="true"/>
    <disallow pkg="java.sql"/>
  </subpackage>

  <!-- SERVICE: không biết HTTP, không biết controller, không dùng kiểu java.sql. -->
  <subpackage name="(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?service" regex="true">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?controller(\..*)?" regex="true"/>
    <disallow pkg="javax.servlet"/>
    <disallow pkg="jakarta.servlet"/>
    <disallow pkg="java.sql"/>
  </subpackage>

  <!-- DAO: chỉ làm việc với DB. Không gọi lên service/controller, không biết HTTP. -->
  <subpackage name="(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?dao" regex="true">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?controller(\..*)?" regex="true"/>
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?service(\..*)?" regex="true"/>
    <disallow pkg="javax.servlet"/>
    <disallow pkg="jakarta.servlet"/>
  </subpackage>

  <!-- DTO / MODEL: chỉ là dữ liệu. Không phụ thuộc controller/service/dao/HTTP. -->
  <subpackage name="(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?(dto|model)" regex="true">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?(controller|service|dao)(\..*)?" regex="true"/>
    <disallow pkg="javax.servlet"/>
    <disallow pkg="jakarta.servlet"/>
  </subpackage>

  <!-- FILTER: không truy vấn DB trực tiếp. -->
  <subpackage name="(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?filter" regex="true">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?dao(\..*)?" regex="true"/>
    <disallow pkg="java.sql"/>
  </subpackage>

  <!-- UTIL: không phụ thuộc vào tầng nào của ứng dụng. -->
  <subpackage name="util">
    <disallow pkg="com\.mycompany\.hotelmanagersystem\.(?:(?!(?:controller|service|dao|dto|model|filter|util)\.)[^.]+\.)?(controller|service|dao|filter)(\..*)?" regex="true"/>
  </subpackage>
</import-control>
