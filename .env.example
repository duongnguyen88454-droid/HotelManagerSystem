# ============================================================================
# CẤU HÌNH MẪU KẾT NỐI MÁY CHỦ CSDL (DATABASE HOST CONFIGURATION TEMPLATE)
# Sao chép file này thành .env và điền mật khẩu thực tế của bạn
# ============================================================================
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=QuanLyKhachSan

# ============================================================================
# TÀI KHOẢN MẶC ĐỊNH HỆ THỐNG
# ============================================================================
DB_USER=sa
DB_PASSWORD=your_sa_password_here

# ============================================================================
# CHÙM TÀI KHOẢN PHÂN QUYỀN THEO VAI TRÒ (RBAC CREDENTIALS)
# ============================================================================
DB_LOGIN_MANAGER=login_manager
DB_PASS_MANAGER=your_manager_password_here

DB_LOGIN_RECEPTIONIST=login_receptionist
DB_PASS_RECEPTIONIST=your_receptionist_password_here

DB_LOGIN_HOUSEKEEPER=login_housekeeper
DB_PASS_HOUSEKEEPER=your_housekeeper_password_here

DB_LOGIN_CUSTOMER=login_customer
DB_PASS_CUSTOMER=your_customer_password_here
